---
import Icon from './Icon.astro';
import { SITE, url } from '../lib/site';

const left = [
  { href: '/proizvodi', label: 'Proizvodi' },
  { href: '/proizvodi#setovi', label: 'Setovi' },
  { href: '/rezultati', label: 'Rezultati' },
];
const right = [
  { href: '/katalog', label: 'Katalog' },
  { href: '/o-nama', label: 'O nama' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
---

<header class="header" data-header>
  <div class="header__bar">
    <button class="header__toggle" type="button" aria-label="Otvori meni" aria-expanded="false" aria-controls="site-nav" data-toggle>
      <Icon name="menu" size={22} />
    </button>

    <nav class="header__nav" id="site-nav" aria-label="Glavna navigacija" data-nav>
      <ul class="header__left">
        {left.map((i) => <li><a href={url(i.href)} aria-current={current === i.href ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
      <ul class="header__right">
        {right.map((i) => <li><a href={url(i.href)} aria-current={current === i.href ? 'page' : undefined}>{i.label}</a></li>)}
        <li><a href={SITE.dm} target="_blank" rel="noopener">Naruči</a></li>
      </ul>
    </nav>

    <a href={url('/')} class="header__logo" aria-label="Aurola – početna">
      <img src={url('/logo.png')} alt="Aurola prirodna kozmetika" width="641" height="247" />
    </a>

    <a class="header__ig" href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram @aurolakozmetika">
      <Icon name="instagram" size={19} />
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Zatvori meni' : 'Otvori meni');
    nav?.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 249, 248, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }

  .header.is-scrolled {
    border-color: var(--line);
  }

  .header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 92px;
    padding-inline: var(--gutter);
    max-width: 1440px;
    margin-inline: auto;
  }

  .header__logo img {
    width: 118px;
    height: auto;
  }

  .header__nav {
    position: absolute;
    inset: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(20px, 3vw, 44px);
    pointer-events: auto;
  }

  .header__right {
    margin-right: 44px;
  }

  .header__nav a {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, color 0.3s;
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    border-color: currentColor;
  }

  .header__ig {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    color: var(--ink);
  }

  .header__toggle {
    display: none;
    position: absolute;
    left: calc(var(--gutter) - 8px);
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: 0;
    padding: 8px;
    color: var(--ink);
    cursor: pointer;
  }

  @media (max-width: 960px) {
    .header__bar {
      min-height: 70px;
    }
    .header__logo img {
      width: 98px;
    }
    .header__toggle {
      display: inline-flex;
    }
    .header__nav {
      position: absolute;
      inset: 100% 0 auto 0;
      height: calc(100dvh - 70px);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 24px var(--gutter);
      background: var(--bg);
      border-top: 1px solid var(--line);
      pointer-events: auto;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s var(--ease), visibility 0.3s;
    }
    .header__nav.is-open {
      opacity: 1;
      visibility: visible;
    }
    .header__nav ul {
      flex-direction: column;
      gap: 0;
    }
    .header__right {
      margin-right: 0;
    }
    .header__nav a {
      display: block;
      font-family: var(--serif);
      font-size: 26px;
      letter-spacing: 0.06em;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
