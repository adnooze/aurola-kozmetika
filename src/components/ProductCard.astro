---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { img, price, url } from '../lib/site';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
---

<article class="card">
  <a href={url(`/proizvodi/${p.slug}`)}>
    <div class="card__media">
      <Image
        src={img(p.image)}
        alt={p.name}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 50vw, (max-width: 1080px) 33vw, 280px"
        style={p.focus ? `object-position:${p.focus}` : undefined}
      />
      {p.badge && <span class="card__tag">{p.badge}</span>}
    </div>
    <h3>{p.name}</h3>
    <p class="card__price">{price(p.price)}</p>
  </a>
</article>

<style>
  .card {
    min-width: 0;
    text-align: center;
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--tile);
    overflow: hidden;
  }

  .card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease), opacity 0.4s;
  }

  .card a:hover .card__media img {
    transform: scale(1.03);
  }

  .card__tag {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--white);
    border-radius: 999px;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 3px 9px;
  }

  .card h3 {
    margin-top: 16px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: none;
    color: var(--ink);
  }

  .card__price {
    margin-top: 2px;
    font-size: 12px;
    color: var(--muted);
  }
</style>
