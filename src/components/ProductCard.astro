---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { img, price, url } from '../lib/site';

interface Props {
  product: Product;
  eager?: boolean;
}

const { product: p, eager = false } = Astro.props;
const href = url(`/proizvodi/${p.slug}`);
---

<article class="card">
  <a class="card__link" href={href}>
    <div class="card__media">
      <Image
        src={img(p.image)}
        alt={p.name}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 50vw, (max-width: 1080px) 33vw, 300px"
        loading={eager ? 'eager' : 'lazy'}
        style={p.focus ? `object-position:${p.focus}` : undefined}
      />
      {p.badge && <span class="card__badge">{p.badge}</span>}
    </div>
    <div class="card__body">
      <h3>{p.name}</h3>
      <p class="card__type">{p.type}</p>
      <p class="card__price">{price(p.price)}{p.size && <span> · {p.size}</span>}</p>
    </div>
  </a>
</article>

<style>
  .card {
    min-width: 0;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 10px 10px 22px;
    transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .card__link:hover {
    box-shadow: 0 24px 48px -32px rgba(59, 37, 33, 0.35);
    transform: translateY(-3px);
  }

  .card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
    background: var(--sand);
  }

  .card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .card__link:hover .card__media img {
    transform: scale(1.04);
  }

  .card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--rose-deep);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .card__body {
    display: grid;
    gap: 2px;
    text-align: center;
    padding: 18px 8px 0;
  }

  .card h3 {
    font-size: 19px;
    line-height: 1.25;
  }

  .card__type {
    font-size: 13px;
    color: var(--muted);
  }

  .card__price {
    margin-top: 8px;
    font-size: 15px;
    font-weight: 500;
  }

  .card__price span {
    font-weight: 400;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .card__link {
      padding: 6px 6px 16px;
      border-radius: 16px;
    }
    .card__media {
      border-radius: 12px;
    }
    .card h3 {
      font-size: 16px;
    }
  }
</style>
