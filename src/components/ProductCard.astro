---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { img, price, url } from '../lib/site';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const cutout = p.image.endsWith('.png');
const href = url(`/proizvodi/${p.slug}`);
---

<article class="card">
  <a class:list={['card__media', { 'card__media--cutout': cutout }]} href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={img(p.image)}
      alt=""
      widths={[320, 480, 640]}
      sizes="(max-width: 640px) 50vw, (max-width: 1080px) 33vw, 280px"
      style={p.focus ? `object-position:${p.focus}` : undefined}
    />
    {p.badge && <span class="card__tag">{p.badge}</span>}
  </a>
  <h3><a href={href}>{p.name}</a></h3>
  <p class="card__price">{price(p.price)}</p>
  <a class="btn btn--sm card__btn" href={href}>Pogledaj</a>
</article>

<style>
  .card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .card__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--pink);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card:nth-child(even) .card__media {
    background: var(--peach);
  }

  .card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .card__media--cutout img {
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: contain;
    filter: drop-shadow(0 14px 14px rgba(125, 44, 59, 0.14));
  }

  .card:hover .card__media img {
    transform: scale(1.04);
  }

  .card__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--wine);
    color: var(--white);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
  }

  .card h3 {
    margin-top: 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    color: var(--ink);
  }

  .card h3 a:hover {
    color: var(--wine);
  }

  .card__price {
    margin-top: 2px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .card__btn {
    margin-top: 12px;
  }
</style>
