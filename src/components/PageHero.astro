---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="wrap page-hero-wrap">
  <div class="page-hero">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero-wrap {
    padding-top: 8px;
  }

  .page-hero {
    background: var(--sand);
    border-radius: var(--radius-lg);
    padding: clamp(40px, 6vw, 88px) clamp(24px, 5vw, 72px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h1 {
    font-size: clamp(38px, 5.2vw, 68px);
    margin-top: 14px;
    max-width: 18ch;
  }

  .page-hero__lead {
    margin-top: 18px;
    max-width: 58ch;
    font-size: 17px;
    color: var(--ink-2);
  }
</style>
