---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    background: linear-gradient(120deg, var(--pink-2) 0%, var(--pink) 100%);
    padding-block: clamp(48px, 7vw, 88px);
    text-align: center;
  }

  .page-hero .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(30px, 4vw, 50px);
  }

  h1 :global(em) {
    font-style: normal;
  }

  .page-hero__lead {
    margin-top: 16px;
    max-width: 54ch;
    font-size: 14px;
  }
</style>
