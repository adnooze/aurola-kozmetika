---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    background: var(--greige);
    padding-block: clamp(56px, 8vw, 104px);
    text-align: center;
  }

  .page-hero .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(32px, 4.2vw, 54px);
    letter-spacing: 0.06em;
  }

  h1 :global(em) {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .page-hero__lead {
    margin-top: 16px;
    max-width: 54ch;
    font-size: 14px;
  }
</style>
