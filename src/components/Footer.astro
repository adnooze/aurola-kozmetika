---
import Icon from './Icon.astro';
import { SITE, url } from '../lib/site';
import { categories } from '../data/products';

const year = new Date().getFullYear();
---

<section class="band">
  <div class="wrap band__inner">
    <div>
      <h2>Naruči svoju rutinu</h2>
      <p>Pošalji nam poruku na Instagramu – pomoći ćemo ti odabrati prave proizvode.</p>
    </div>
    <div class="band__actions">
      <a class="btn btn--white" href={SITE.dm} target="_blank" rel="noopener"><Icon name="chat" /> Pošalji poruku</a>
      <a class="btn band__ghost" href={SITE.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> {SITE.handle}</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <img src={url('/logo.png')} alt="Aurola prirodna kozmetika" width="641" height="247" loading="lazy" />
      <p>Prirodna kozmetika za jaču, gušću i ljepšu kosu.</p>
    </div>

    <div>
      <h3>Proizvodi</h3>
      <ul>
        {categories.map((c) => <li><a href={url(`/proizvodi#${c.id}`)}>{c.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h3>Aurola</h3>
      <ul>
        <li><a href={url('/o-nama')}>O nama</a></li>
        <li><a href={url('/rezultati')}>Rezultati</a></li>
        <li><a href={url('/katalog')}>Katalog</a></li>
        <li><a href={url('/o-nama#narudzba')}>Kako naručiti</a></li>
      </ul>
    </div>

    <div>
      <h3>Kontakt</h3>
      <ul>
        <li><a href={SITE.dm} target="_blank" rel="noopener">Instagram poruke</a></li>
        <li><a href={SITE.instagram} target="_blank" rel="noopener">{SITE.handle}</a></li>
        <li>Poštarina {SITE.shipping}</li>
      </ul>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>© {year} Aurola · Prirodna kozmetika</p>
  </div>
</footer>

<style>
  .band {
    background: var(--wine);
    color: rgba(255, 255, 255, 0.82);
    padding-block: clamp(36px, 5vw, 56px);
  }

  .band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .band h2 {
    color: var(--white);
    font-size: clamp(22px, 2.4vw, 30px);
  }

  .band p {
    margin-top: 8px;
    font-size: 14px;
  }

  .band__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .band__ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.6);
  }

  .band__ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--white);
  }

  .footer {
    background: var(--pink-2);
    padding-top: clamp(48px, 6vw, 72px);
    font-size: 13px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
  }

  .footer__brand img {
    width: 120px;
  }

  .footer__brand p {
    margin-top: 16px;
    max-width: 26ch;
  }

  .footer h3 {
    font-size: 11px;
    letter-spacing: 0.18em;
    margin-bottom: 16px;
  }

  .footer li + li {
    margin-top: 8px;
  }

  .footer a {
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--wine);
  }

  .footer__bottom {
    margin-top: 48px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
