---
import { SITE, url } from '../lib/site';
import { categories } from '../data/products';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <img src={url('/logo.png')} alt="Aurola prirodna kozmetika" width="641" height="247" loading="lazy" />
      <p>Prirodna kozmetika za jaču, gušću i ljepšu kosu.</p>
    </div>

    <div>
      <h3>Proizvodi</h3>
      <ul>
        {categories.map((c) => <li><a href={url(`/proizvodi#${c.id}`)}>{c.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h3>Aurola</h3>
      <ul>
        <li><a href={url('/o-nama')}>O nama</a></li>
        <li><a href={url('/rezultati')}>Rezultati</a></li>
        <li><a href={url('/katalog')}>Katalog</a></li>
        <li><a href={url('/o-nama#narudzba')}>Kako naručiti</a></li>
      </ul>
    </div>

    <div>
      <h3>Kontakt</h3>
      <ul>
        <li><a href={SITE.dm} target="_blank" rel="noopener">Instagram poruke</a></li>
        <li><a href={SITE.instagram} target="_blank" rel="noopener">{SITE.handle}</a></li>
        <li>Poštarina {SITE.shipping}</li>
      </ul>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>© {year} Aurola</p>
    <p>Prirodna kozmetika</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(56px, 7vw, 88px);
    font-size: 13px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
  }

  .footer__brand img {
    width: 120px;
  }

  .footer__brand p {
    margin-top: 18px;
    max-width: 26ch;
  }

  .footer h3 {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    margin-bottom: 18px;
  }

  .footer li + li {
    margin-top: 8px;
  }

  .footer a {
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--ink);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
    padding-block: 22px 30px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
