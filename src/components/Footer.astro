---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { SITE, img, url } from '../lib/site';
import { categories } from '../data/products';

const year = new Date().getFullYear();
---

<section class="cta-wrap">
  <div class="wrap">
    <div class="cta">
      <div class="cta__copy">
        <h2>Spremna za kosu<br /><em>bez mane?</em></h2>
        <p>Pošalji nam poruku na Instagramu – pomoći ćemo ti odabrati pravu rutinu i poslati narudžbu na tvoju adresu.</p>
        <div class="cta__actions">
          <a class="btn btn--light" href={SITE.dm} target="_blank" rel="noopener"><Icon name="chat" /> Naruči u DM</a>
          <a class="cta__link" href={SITE.instagram} target="_blank" rel="noopener">{SITE.handle}</a>
        </div>
      </div>
      <Image class="cta__img" src={img('products/ulje-25u1.jpg')} alt="" widths={[400, 600]} sizes="(max-width: 860px) 100vw, 420px" />
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <p class="footer__name">Aurola</p>
      <p>Prirodna kozmetika za jaču, gušću i ljepšu kosu koja brže raste i ne opada.</p>
      <a class="footer__social" href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <Icon name="instagram" />
      </a>
    </div>

    <div>
      <h3>Proizvodi</h3>
      <ul>
        {categories.map((c) => <li><a href={url(`/proizvodi#${c.id}`)}>{c.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h3>Aurola</h3>
      <ul>
        <li><a href={url('/o-nama')}>O nama</a></li>
        <li><a href={url('/rezultati')}>Rezultati</a></li>
        <li><a href={url('/katalog')}>Katalog proizvoda</a></li>
        <li><a href={url('/o-nama#narudzba')}>Kako naručiti</a></li>
      </ul>
    </div>

    <div>
      <h3>Kontakt</h3>
      <ul>
        <li>Za narudžbe i pitanja</li>
        <li><a class="footer__strong" href={SITE.dm} target="_blank" rel="noopener">Instagram – {SITE.handle}</a></li>
        <li>Poštarina {SITE.shipping}</li>
      </ul>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>© {year} Aurola · Prirodna kozmetika</p>
    <p>Sva prava zadržana.</p>
  </div>
</footer>

<style>
  .cta-wrap {
    padding-bottom: var(--space);
  }

  .cta {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    background: var(--brown);
    color: var(--on-dark);
    border-radius: var(--radius-lg);
    padding: clamp(28px, 4.5vw, 64px);
  }

  .cta h2 {
    font-size: clamp(34px, 4.4vw, 58px);
  }

  .cta__copy p {
    margin-top: 18px;
    max-width: 44ch;
    color: rgba(245, 237, 230, 0.75);
  }

  .cta__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .cta__link {
    font-size: 14px;
    border-bottom: 1px solid rgba(245, 237, 230, 0.5);
  }

  .cta__img {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: 16px;
  }

  .footer {
    background: var(--brown);
    color: rgba(245, 237, 230, 0.72);
    padding-top: clamp(56px, 7vw, 88px);
    font-size: 14px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 40px;
  }

  .footer__name {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 40px;
    line-height: 1;
    color: var(--on-dark);
    margin-bottom: 16px;
  }

  .footer__brand p:not(.footer__name) {
    max-width: 32ch;
  }

  .footer h3 {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--on-dark);
    margin-bottom: 18px;
  }

  .footer li + li {
    margin-top: 10px;
  }

  .footer ul a {
    transition: color 0.2s;
  }

  .footer ul a:hover {
    color: #fff;
  }

  .footer__strong {
    color: var(--on-dark);
  }

  .footer__social {
    display: inline-flex;
    margin-top: 22px;
    color: var(--on-dark);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 56px;
    padding-block: 22px 28px;
    border-top: 1px solid rgba(245, 237, 230, 0.14);
    font-size: 12px;
    color: rgba(245, 237, 230, 0.5);
  }

  @media (max-width: 860px) {
    .cta {
      grid-template-columns: 1fr;
    }
    .cta__img {
      order: -1;
      aspect-ratio: 16 / 10;
    }
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
