---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { bySlug } from '../data/products';
import { results } from '../data/results';
import { SITE, img, price, url } from '../lib/site';

const pick = (...slugs: string[]) => slugs.map((s) => bySlug(s)!);

const bestsellers = pick('serum-sa-pet-zlatnih-ulja', 'aktivne-ampule', 'sprej-za-rast-kose', 'ulje-za-kosu-25u1');
const care = pick('sampon-za-kosu', 'balzam-za-kosu', 'maska-za-kosu', 'regenerator-za-kosu-3u1');
const duo = bySlug('duo-za-rast-i-oporavak-kose')!;

const features = [
  {
    p: bySlug('serum-sa-pet-zlatnih-ulja')!,
    title: 'Serum sa pet zlatnih ulja',
    text: 'Naš najprodavaniji proizvod. Ricinus, maslina, čičak, avokado i laneno ulje hrane tjeme, ubrzavaju rast i progušćuju kosu.',
    tone: 'pink',
  },
  {
    p: bySlug('maska-protiv-mascenja-kose')!,
    title: 'Maska protiv mašćenja',
    text: 'Novo! Hamamelis, zelena i bijela glina, ruzmarin i mentol vraćaju balans masnom vlasištu – kosa duže ostaje svježa.',
    tone: 'peach',
  },
];

const strip = results.slice(0, 5);
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__text">
        <p class="kicker">Prirodna kozmetika za kosu</p>
        <h1>Jača, gušća i ljepša kosa</h1>
        <p class="hero__lead">Proizvodi na prirodnoj bazi koji pomažu da kosa brže raste i ne opada.</p>
        <div class="hero__actions">
          <a class="btn" href={url('/proizvodi')}>Pogledaj proizvode</a>
          <a class="btn btn--outline" href={SITE.dm} target="_blank" rel="noopener">Naruči u DM</a>
        </div>
      </div>
      <div class="hero__visual">
        <span class="hero__ring" aria-hidden="true"></span>
        <Image
          src={img('cutouts/set-trio.png')}
          alt="Aurola sprej za rast kose, aktivne ampule i serum sa pet zlatnih ulja"
          widths={[480, 720, 960]}
          sizes="(max-width: 860px) 90vw, 560px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="wrap perks" aria-label="Zašto Aurola">
    <div><Icon name="leaf" size={24} /><span>Prirodna baza</span></div>
    <div><Icon name="drop" size={24} /><span>Bez agresivnih sastojaka</span></div>
    <div><Icon name="sparkle" size={24} /><span>Vidljivi rezultati</span></div>
    <div><Icon name="truck" size={24} /><span>Poštarina {SITE.shipping}</span></div>
  </section>

  <!-- BESTSELERI -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2 class="title">Bestseleri</h2>
        <p>Najomiljeniji proizvodi naših djevojaka</p>
      </div>
      <div class="grid-4">
        {bestsellers.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="wrap features">
    {
      features.map((f, i) => (
        <article class:list={['feature', { 'feature--rev': i % 2 }]}>
          <a class:list={['feature__media', `feature__media--${f.tone}`]} href={url(`/proizvodi/${f.p.slug}`)} tabindex="-1" aria-hidden="true">
            <Image src={img(f.p.image)} alt="" widths={[400, 600, 800]} sizes="(max-width: 760px) 90vw, 520px" />
          </a>
          <div class="feature__text reveal">
            {f.p.badge && <p class="kicker">{f.p.badge}</p>}
            <h2>{f.title}</h2>
            <p>{f.text}</p>
            <p class="feature__price">{price(f.p.price)}</p>
            <a class="btn" href={url(`/proizvodi/${f.p.slug}`)}>Pogledaj</a>
          </div>
        </article>
      ))
    }
  </section>

  <!-- PROMO -->
  <section class="promo">
    <div class="wrap promo__inner">
      <div class="promo__text reveal">
        <p class="kicker">Najprodavaniji set</p>
        <h2>Duo za rast<br />i oporavak kose</h2>
        <p>Serum + aktivne ampule · dovoljno za 2 mjeseca njege</p>
        <p class="promo__price">{price(duo.price)}</p>
        <a class="btn btn--white" href={url(`/proizvodi/${duo.slug}`)}>Pogledaj set</a>
      </div>
      <div class="promo__visual">
        <Image src={img(duo.image)} alt="Aurola aktivne ampule i serum sa pet zlatnih ulja" widths={[480, 720, 960]} sizes="(max-width: 760px) 90vw, 560px" />
      </div>
    </div>
  </section>

  <!-- NJEGA -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2 class="title">Njega i sjaj</h2>
        <p>Šampon, balzam, maske i leave-in njega</p>
      </div>
      <div class="grid-4">
        {care.map((p) => <ProductCard product={p} />)}
      </div>
      <p class="center more-wrap"><a class="more" href={url('/proizvodi')}>Svi proizvodi</a></p>
    </div>
  </section>

  <!-- DJECA -->
  <section class="wrap">
    <article class="feature feature--rev">
      <a class="feature__media feature__media--pink" href={url('/proizvodi#djeca')} tabindex="-1" aria-hidden="true">
        <Image src={img('cutouts/set-za-princeze.png')} alt="" widths={[400, 600]} sizes="(max-width: 760px) 90vw, 520px" />
      </a>
      <div class="feature__text reveal">
        <p class="kicker">Set za kosu</p>
        <h2>Za male princeze</h2>
        <p>Šampon, balzam i regenerator za djecu – nježne formule bez sapuna i mirisa koji djeca obožavaju.</p>
        <p class="feature__price">od {price(15)}</p>
        <a class="btn" href={url('/proizvodi#djeca')}>Pogledaj</a>
      </div>
    </article>
  </section>

  <!-- REZULTATI -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2 class="title">Rezultati naših djevojaka</h2>
        <p>Fotografije koje su nam poslale korisnice</p>
      </div>
      <div class="strip">
        {
          strip.map((r) => (
            <a href={url('/rezultati')}>
              <Image src={img(r.image)} alt={`Rezultat korisnice: ${r.label}`} widths={[240, 360]} sizes="(max-width: 760px) 45vw, 220px" />
            </a>
          ))
        }
      </div>
      <p class="center more-wrap"><a class="more" href={url('/rezultati')}>Svi rezultati</a></p>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero {
    background: linear-gradient(120deg, var(--pink-2) 0%, var(--pink) 100%);
  }

  .hero__inner {
    max-width: var(--wrap);
    margin-inline: auto;
    padding: clamp(48px, 7vw, 96px) var(--gutter);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }

  .hero h1 {
    margin-top: 14px;
    font-size: clamp(38px, 5vw, 66px);
    line-height: 1.02;
    max-width: 11ch;
  }

  .hero__lead {
    margin-top: 18px;
    font-size: 16px;
    max-width: 36ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .hero__visual {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero__ring {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.9), 0 0 0 18px rgba(255, 255, 255, 0.18);
  }

  .hero__visual img {
    position: relative;
    width: 100%;
    max-width: 560px;
    filter: drop-shadow(0 24px 24px rgba(125, 44, 59, 0.18));
  }

  /* PERKS */
  .perks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }

  .perks div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--wine);
    text-align: center;
  }

  .perks span {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* HEAD + GRID */
  .head {
    text-align: center;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .head p {
    margin-top: 8px;
    font-size: 14px;
  }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap);
  }

  .more-wrap {
    margin-top: 36px;
  }

  /* FEATURES */
  .features {
    display: grid;
    gap: var(--gap);
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--gap);
  }

  .feature--rev .feature__media {
    order: 2;
  }

  .feature__media {
    position: relative;
    display: block;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .feature__media--pink {
    background: var(--pink);
  }

  .feature__media--peach {
    background: var(--peach);
  }

  .feature__media img {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: contain;
    filter: drop-shadow(0 20px 20px rgba(125, 44, 59, 0.16));
    transition: transform 0.8s var(--ease);
  }

  .feature__media:hover img {
    transform: scale(1.04);
  }

  .feature__text {
    padding: clamp(16px, 4vw, 64px);
  }

  .feature__text h2 {
    margin-top: 8px;
    font-size: clamp(24px, 2.8vw, 36px);
  }

  .feature__text p:not(.kicker):not(.feature__price) {
    margin-top: 14px;
    max-width: 40ch;
  }

  .feature__price {
    margin-block: 18px 20px;
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
  }

  /* PROMO */
  .promo {
    margin-top: var(--space);
    background: var(--wine);
    color: rgba(255, 255, 255, 0.82);
  }

  .promo__inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    padding-block: clamp(48px, 6vw, 80px);
  }

  .promo .kicker {
    color: rgba(255, 255, 255, 0.7);
  }

  .promo h2 {
    margin-top: 10px;
    color: var(--white);
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.05;
  }

  .promo__text > p:not(.kicker):not(.promo__price) {
    margin-top: 16px;
  }

  .promo__price {
    margin-block: 18px 24px;
    font-size: 28px;
    font-weight: 600;
    color: var(--white);
  }

  .promo__visual img {
    width: 100%;
    max-width: 580px;
    margin-inline: auto;
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.3));
  }

  /* STRIP */
  .strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }

  .strip a {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .strip img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .strip a:hover img {
    transform: scale(1.05);
  }

  /* RESPONSIVE */
  @media (max-width: 960px) {
    .grid-4 {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 32px;
    }
  }

  @media (max-width: 760px) {
    .hero__inner,
    .promo__inner,
    .feature {
      grid-template-columns: 1fr;
    }
    .hero__inner {
      text-align: center;
    }
    .hero h1,
    .hero__lead {
      margin-inline: auto;
    }
    .hero__actions {
      justify-content: center;
    }
    .feature--rev .feature__media {
      order: 0;
    }
    .feature__text {
      padding: 8px 4px 24px;
      text-align: center;
    }
    .feature__text p:not(.kicker):not(.feature__price) {
      margin-inline: auto;
    }
    .promo__inner {
      text-align: center;
    }
    .perks {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 20px;
    }
    .strip {
      grid-template-columns: repeat(3, 1fr);
    }
    .strip a:nth-child(n + 4) {
      display: none;
    }
  }
</style>
