---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories, inCategory } from '../../data/products';
import { products } from '../../data/products';
---

<Layout title="Proizvodi" description="Svi Aurola proizvodi za kosu: serum, ampule, sprej za rast, maske, šampon, balzam, ulja i dječja linija.">
  <PageHero
    eyebrow="Asortiman"
    title="Proizvodi za kosu <em>bez mane</em>"
    lead={`${products.length} proizvoda na prirodnoj bazi – za rast kose, masno vlasište, svakodnevnu njegu i male princeze.`}
  >
    <nav class="chips" aria-label="Kategorije">
      {categories.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
    </nav>
  </PageHero>

  {
    categories.map((c) => (
      <section class="section section--cat" id={c.id}>
        <div class="wrap">
          <div class="cat-head">
            <h2>{c.label}</h2>
            <p>{c.blurb}</p>
          </div>
          <div class="grid">
            {inCategory(c.id).map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Layout>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .chips {
    justify-content: center;
  }

  .chips {
    gap: 8px 28px;
  }

  .chips a {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }

  .chips a:hover {
    border-color: currentColor;
  }

  .section--cat {
    padding-block: clamp(40px, 6vw, 72px) 0;
    scroll-margin-top: 80px;
  }

  .section--cat:last-of-type {
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .cat-head {
    display: flex;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    padding-bottom: 18px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .cat-head h2 {
    font-size: clamp(24px, 2.6vw, 32px);
  }

  .cat-head p {
    font-size: 13px;
  }

  .cat-head p {
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>
